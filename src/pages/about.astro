---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE_NAME, LAST_UPDATED } from '../lib/site';
---

<BaseLayout
  title={`About — ${SITE_NAME}`}
  description={`Why ${SITE_NAME} exists: fast, transparent, free calculators for concrete and gravel projects, with the math shown.`}
>
  <Breadcrumbs items={[{ name: 'Home', path: '/' }, { name: 'About' }]} />

  <section class="card">
    <h1>About {SITE_NAME}</h1>
    <p class="lead">A small collection of free, single-purpose calculators for DIY concrete and gravel
      projects — how many bags of concrete you need, how much gravel for a driveway, concrete per fence post.</p>
  </section>

  <section class="card">
    <h2>What we believe</h2>
    <p>Most search results for these questions mix ads, long blog posts, and half-answers. We take a
      different approach: each tool does <b>one job</b>, runs instantly in your browser, and
      <b>shows its math</b> so you can trust the number and adjust it to your situation.</p>
  </section>

  <section class="card">
    <h2>How the tools work</h2>
    <p>Every calculator uses a standard geometric formula — rectangular volume for slabs, cylindrical
      volume for post holes, and manufacturer bag-yield figures for concrete mix. The fence-post tool
      also subtracts the volume occupied by the buried post.</p>
    <p>Tools are free, require no account, and your inputs never leave your device.</p>
  </section>

  <section class="card">
    <h2>Editorial standards</h2>
    <p>Formulas are reviewed against manufacturer specification sheets and standard construction
      references. When material density or yield varies by product, the page states the assumption
      used and recommends confirming with the supplier.</p>
  </section>

  <section class="card">
    <h2>Who runs it</h2>
    <p>{SITE_NAME} is an independent project built for homeowners and DIYers. We earn a small
      amount from non-intrusive ads and clearly disclosed affiliate links so the tools can stay free.
      Questions? Visit the <a href="/contact/">Contact page</a>.</p>
    <p class="muted">Last reviewed: {LAST_UPDATED}</p>
  </section>
</BaseLayout>
