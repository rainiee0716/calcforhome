---
import BaseLayout from '../layouts/BaseLayout.astro';

const schema = {
  '@context': 'https://schema.org', '@type': 'SoftwareApplication',
  'name': 'Gravel for Driveway Calculator', 'applicationCategory': 'UtilitiesApplication',
  'operatingSystem': 'Web', 'offers': { '@type': 'Offer', 'price': '0', 'priceCurrency': 'USD' },
};
---

<BaseLayout
  title="Gravel for Driveway Calculator — Cubic Yards & Tons"
  description="Free gravel calculator for driveways: enter length, width and depth to get cubic yards and tons of gravel needed, with a waste margin. Works for driveways, paths and patio bases."
  schema={schema}
>
  <section class="card">
    <h1>Gravel for Driveway Calculator</h1>
    <p class="lead">How much gravel do you need for a driveway? Enter the size and depth — we'll give
      you cubic yards and tons, plus a sensible waste margin.</p>

    <div class="calc">
      <div class="row"><label for="len">Driveway length (ft)</label><input id="len" type="number" min="0.1" step="0.1" value="50"></div>
      <div class="row"><label for="wid">Driveway width (ft)</label><input id="wid" type="number" min="0.1" step="0.1" value="10"></div>
      <div class="row"><label for="dep">Depth (in)</label><input id="dep" type="number" min="0.5" step="0.5" value="4"></div>
      <div class="row"><label for="waste">Waste (%)</label><input id="waste" type="number" min="0" max="30" step="1" value="10"></div>
      <button class="btn" id="go">Calculate</button>
    </div>

    <div class="result" id="out" hidden>
      <h3>You need about</h3>
      <p><span class="big" id="cy">—</span> cubic yards</p>
      <ul>
        <li>Tons: <b id="tons">—</b></li>
        <li>Cubic feet: <b id="cf">—</b></li>
      </ul>
    </div>
  </section>

  <!-- ===== AdSense: in-content =====
  <div class="ad"><div class="box">[AdSense — in-article]</div></div>
  -->

  <section class="card">
    <h2>How the gravel calculator works</h2>
    <p><code>volume = length × width × (depth ÷ 12)</code> gives cubic feet; divide by 27 for cubic yards.
      Loose gravel weighs about <b>1.4 tons per cubic yard</b>, so we multiply cubic yards by 1.4 for tons.</p>
    <p>A 4-inch base is standard for a driveway over firm soil; use 6–8 inches if the ground is soft or
      you'll park heavy vehicles. Always round the final order up — suppliers sell by the yard and you
      can't return the excess easily.</p>
    <h3>Related tools</h3>
    <p><a href="/concrete-calculator/">Concrete calculator</a> · <a href="/concrete-bags-calculator/">Concrete bags calculator</a> · <a href="/concrete-fence-post-calculator/">Concrete for fence post</a></p>
  </section>
</BaseLayout>

<script>
function calc(){
  var L=parseFloat((document.getElementById('len') as HTMLInputElement).value),
      W=parseFloat((document.getElementById('wid') as HTMLInputElement).value),
      dep=parseFloat((document.getElementById('dep') as HTMLInputElement).value),
      waste=parseFloat((document.getElementById('waste') as HTMLInputElement).value)||0;
  if(!(L>0&&W>0&&dep>0)) return;
  var cf=L*W*(dep/12);
  var withWaste=cf*(1+waste/100);
  var cy=withWaste/27;
  var tons=cy*1.4;
  document.getElementById('cy')!.textContent=cy.toFixed(2);
  document.getElementById('tons')!.textContent=tons.toFixed(1);
  document.getElementById('cf')!.textContent=cf.toFixed(1);
  document.getElementById('out')!.removeAttribute('hidden');
}
document.getElementById('go')!.addEventListener('click',calc);
</script>
