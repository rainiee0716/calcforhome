---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ToolIcon from '../components/ToolIcon.astro';
import { calculateConcrete } from '../lib/calculations';
import { breadcrumbSchema, softwareApplicationSchema } from '../lib/schema';
import { LAST_UPDATED } from '../lib/site';

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const schema = [
  softwareApplicationSchema('Concrete Calculator', '/concrete-calculator/', siteUrl),
  breadcrumbSchema(
    [
      { name: 'Home', path: '/' },
      { name: 'Concrete Calculator', path: '/concrete-calculator/' },
    ],
    siteUrl,
  ),
];
---

<BaseLayout
  title="Concrete Calculator — Slab & Footing Volume in Cubic Yards"
  description="Free concrete calculator: enter slab length, width and thickness to get the volume in cubic feet and cubic yards, plus how many 80 lb bags you need. Works for slabs, footings and pads."
  schema={schema}
>
  <Breadcrumbs items={[{ name: 'Home', path: '/' }, { name: 'Concrete Calculator' }]} />

  <section class="card">
    <div class="page-head">
      <span class="tool-icon"><ToolIcon slug="concrete-calculator" /></span>
      <div>
        <h1>Concrete Calculator</h1>
        <p class="lead">How much concrete for your slab or footing? Enter the dimensions and we'll give
          you the volume in cubic feet, cubic yards, and the number of 80&nbsp;lb bags.</p>
      </div>
    </div>

    <form id="calculator-form" class="calc" novalidate>
      <div class="row">
        <label for="length">Length (ft)</label>
        <input id="length" name="length" type="number" min="0.1" step="0.1" value="10" required inputmode="decimal" autocomplete="off">
      </div>
      <div class="row">
        <label for="width">Width (ft)</label>
        <input id="width" name="width" type="number" min="0.1" step="0.1" value="10" required inputmode="decimal" autocomplete="off">
      </div>
      <div class="row">
        <label for="thickness">Thickness (in)</label>
        <input id="thickness" name="thickness" type="number" min="0.5" step="0.5" value="4" required inputmode="decimal" autocomplete="off">
      </div>
      <div class="row">
        <label for="waste">Waste (%)</label>
        <input id="waste" name="waste" type="number" min="0" max="30" step="1" value="10" required inputmode="decimal" autocomplete="off" aria-describedby="waste-help">
        <p id="waste-help" class="field-help">Allowed range: 0–30%. Most DIY slabs use 10%.</p>
      </div>
      <p id="form-error" class="error" role="alert" hidden></p>
      <button class="btn" type="submit">Calculate</button>
    </form>

    <div class="result" id="result" aria-live="polite" hidden>
      <h3>You need about</h3>
      <p><span class="big" id="cubic-yards">—</span> cubic yards</p>
      <ul>
        <li>Cubic feet: <b id="cubic-feet">—</b></li>
        <li>80 lb bags: <b id="eighty-pound-bags">—</b></li>
      </ul>
    </div>
  </section>

  <section class="card">
    <h2>How the concrete calculator works</h2>
    <p><code>volume = length × width × (thickness ÷ 12)</code> gives cubic feet. Divide by 27 for
      cubic yards. One 80&nbsp;lb bag of concrete mix yields about <b>0.60 cubic feet</b>, so we
      divide the total volume by 0.60 and round up.</p>
    <p>Add 10% waste for slabs poured on uneven ground, and 15% if you're a first-timer — it's cheaper
      to have a little left than to stop mid-pour. For exact bag counts by size, use the
      <a href="/concrete-bags-calculator/">Concrete Bags Calculator</a>.</p>
    <h3>Assumptions and sources</h3>
    <p>Bag yields use standard manufacturer data for 80&nbsp;lb concrete mix. Results are estimates;
      verify local mix specifications before ordering.</p>
    <h3>Related tools</h3>
    <p><a href="/concrete-bags-calculator/">Concrete bags calculator</a> · <a href="/gravel-driveway-calculator/">Gravel for driveway</a> · <a href="/concrete-fence-post-calculator/">Concrete for fence post</a></p>
    <p class="muted">Last updated: {LAST_UPDATED}</p>
  </section>
</BaseLayout>

<script>
  import { calculateConcrete } from '../lib/calculations';

  const form = document.querySelector<HTMLFormElement>('#calculator-form')!;
  const error = document.querySelector<HTMLElement>('#form-error')!;
  const result = document.querySelector<HTMLElement>('#result')!;

  function showError(message: string) {
    error.textContent = message;
    error.removeAttribute('hidden');
    result.setAttribute('hidden', '');
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    try {
      const values = calculateConcrete({
        lengthFt: Number((form.elements.namedItem('length') as HTMLInputElement).value),
        widthFt: Number((form.elements.namedItem('width') as HTMLInputElement).value),
        thicknessIn: Number((form.elements.namedItem('thickness') as HTMLInputElement).value),
        wastePercent: Number((form.elements.namedItem('waste') as HTMLInputElement).value),
      });

      document.querySelector('#cubic-yards')!.textContent = values.cubicYards.toFixed(2);
      document.querySelector('#cubic-feet')!.textContent = values.cubicFeet.toFixed(1);
      document.querySelector('#eighty-pound-bags')!.textContent =
        values.eightyPoundBags.toLocaleString();

      error.setAttribute('hidden', '');
      result.removeAttribute('hidden');
    } catch (err) {
      showError(err instanceof Error ? err.message : 'Please check your measurements.');
    }
  });
</script>
