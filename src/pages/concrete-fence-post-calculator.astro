---
import BaseLayout from '../layouts/BaseLayout.astro';

const schema = {
  '@context': 'https://schema.org', '@type': 'SoftwareApplication',
  'name': 'Concrete for Fence Post Calculator', 'applicationCategory': 'UtilitiesApplication',
  'operatingSystem': 'Web', 'offers': { '@type': 'Offer', 'price': '0', 'priceCurrency': 'USD' },
};
---

<BaseLayout
  title="Concrete for Fence Post Calculator — Bags per Post Hole"
  description="Free fence post concrete calculator: enter the number of posts, hole diameter and depth to get total concrete in cubic feet and the number of 80 lb bags needed, per post and for the whole fence."
  schema={schema}
>
  <section class="card">
    <h1>Concrete for Fence Post Calculator</h1>
    <p class="lead">How much concrete per fence post? Enter your post count and hole size — we'll give
      you bags per hole and the total for the whole run.</p>

    <div class="calc">
      <div class="row"><label for="posts">Number of posts</label><input id="posts" type="number" min="1" step="1" value="10"></div>
      <div class="row"><label for="dia">Hole diameter (in)</label><input id="dia" type="number" min="2" step="0.5" value="12"></div>
      <div class="row"><label for="dep">Hole depth (in)</label><input id="dep" type="number" min="6" step="1" value="30"></div>
      <button class="btn" id="go">Calculate</button>
    </div>

    <div class="result" id="out" hidden>
      <h3>You need about</h3>
      <p><span class="big" id="bags">—</span> 80 lb bags total</p>
      <ul>
        <li>Per post: <b id="per">—</b> bags</li>
        <li>Total cubic feet: <b id="cf">—</b></li>
      </ul>
    </div>
  </section>

  <!-- ===== AdSense: in-content =====
  <div class="ad"><div class="box">[AdSense — in-article]</div></div>
  -->

  <section class="card">
    <h2>How the fence post concrete calculator works</h2>
    <p>A post hole is a cylinder: <code>volume per hole = π × (diameter ÷ 2 ÷ 12)² × (depth ÷ 12)</code>
      in cubic feet. Multiply by the number of posts for the total, then divide by <b>0.60</b> (one 80&nbsp;lb
      bag) and round up.</p>
    <p>A common rule is to set posts one-third of their height into the ground and dig the hole three
      times the post width. For a 4×4 post, a 12-inch hole is typical; a 6×6 needs about 18 inches.</p>
    <h3>Related tools</h3>
    <p><a href="/concrete-bags-calculator/">Concrete bags calculator</a> · <a href="/concrete-calculator/">Concrete calculator</a> · <a href="/gravel-driveway-calculator/">Gravel for driveway</a></p>
  </section>
</BaseLayout>

<script>
function calc(){
  var posts=parseFloat((document.getElementById('posts') as HTMLInputElement).value),
      dia=parseFloat((document.getElementById('dia') as HTMLInputElement).value),
      dep=parseFloat((document.getElementById('dep') as HTMLInputElement).value);
  if(!(posts>0&&dia>0&&dep>0)) return;
  var r=dia/2/12;
  var perHole=Math.PI*r*r*(dep/12);
  var total=perHole*posts;
  var bags=Math.ceil(total/0.60);
  var per=Math.ceil(perHole/0.60);
  document.getElementById('bags')!.textContent=bags.toLocaleString();
  document.getElementById('per')!.textContent=per.toLocaleString();
  document.getElementById('cf')!.textContent=total.toFixed(2);
  document.getElementById('out')!.removeAttribute('hidden');
}
document.getElementById('go')!.addEventListener('click',calc);
</script>
