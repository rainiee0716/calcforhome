---
import BaseLayout from '../layouts/BaseLayout.astro';

const schema = {
  '@context': 'https://schema.org', '@type': 'SoftwareApplication',
  'name': 'Concrete Bags Calculator', 'applicationCategory': 'UtilitiesApplication',
  'operatingSystem': 'Web', 'offers': { '@type': 'Offer', 'price': '0', 'priceCurrency': 'USD' },
};
---

<BaseLayout
  title="Concrete Bags Calculator — How Many Bags of Concrete Do I Need"
  description="Free concrete bags calculator: enter your slab or footing size and see exactly how many 80 lb, 60 lb or 40 lb bags of concrete mix you need, with waste included. No guessing, no over-ordering."
  schema={schema}
>
  <section class="card">
    <h1>How Many Bags of Concrete Do I Need?</h1>
    <p class="lead">Enter your project size and pick a bag weight — we'll tell you the exact number of
      bags to buy, rounded up and including a waste margin.</p>

    <div class="calc">
      <div class="row"><label for="len">Length (ft)</label><input id="len" type="number" min="0.1" step="0.1" value="10"></div>
      <div class="row"><label for="wid">Width (ft)</label><input id="wid" type="number" min="0.1" step="0.1" value="10"></div>
      <div class="row"><label for="th">Thickness (in)</label><input id="th" type="number" min="0.5" step="0.5" value="4"></div>
      <div class="row"><label for="bag">Bag size</label>
        <select id="bag">
          <option value="0.60">80 lb (~0.60 cu ft)</option>
          <option value="0.45">60 lb (~0.45 cu ft)</option>
          <option value="0.30">40 lb (~0.30 cu ft)</option>
        </select>
      </div>
      <div class="row"><label for="waste">Waste (%)</label><input id="waste" type="number" min="0" max="30" step="1" value="10"></div>
      <button class="btn" id="go">Calculate</button>
    </div>

    <div class="result" id="out" hidden>
      <h3>You need about</h3>
      <p><span class="big" id="bags">—</span> bags</p>
      <ul>
        <li>Cubic yards: <b id="cy">—</b></li>
        <li>80 lb bags equivalent: <b id="bags80">—</b></li>
      </ul>
    </div>
  </section>

  <!-- ===== AdSense: in-content =====
  <div class="ad"><div class="box">[AdSense — in-article]</div></div>
  -->

  <section class="card">
    <h2>How many bags — the math</h2>
    <p><code>volume (cu ft) = length × width × (thickness ÷ 12)</code>. Each bag yields a fixed volume:
      an <b>80&nbsp;lb</b> bag ≈ 0.60&nbsp;cu&nbsp;ft, a <b>60&nbsp;lb</b> bag ≈ 0.45&nbsp;cu&nbsp;ft, and a
      <b>40&nbsp;lb</b> bag ≈ 0.30&nbsp;cu&nbsp;ft (Quikrete / standard mix figures). We divide your total
      volume by the chosen bag yield and round up, then add your waste margin.</p>
    <p>Most home-center mixes are 80&nbsp;lb, so that's the default. If you're mixing by hand or have a
      smaller drill, 60&nbsp;lb bags are easier to handle; 40&nbsp;lb bags suit small repairs.</p>
    <h3>Related tools</h3>
    <p><a href="/concrete-calculator/">Concrete calculator (cubic yards)</a> · <a href="/concrete-fence-post-calculator/">Concrete for fence post</a> · <a href="/gravel-driveway-calculator/">Gravel for driveway</a></p>
  </section>
</BaseLayout>

<script>
function calc(){
  var L=parseFloat((document.getElementById('len') as HTMLInputElement).value),
      W=parseFloat((document.getElementById('wid') as HTMLInputElement).value),
      th=parseFloat((document.getElementById('th') as HTMLInputElement).value),
      yield_=parseFloat((document.getElementById('bag') as HTMLSelectElement).value),
      waste=parseFloat((document.getElementById('waste') as HTMLInputElement).value)||0;
  if(!(L>0&&W>0&&th>0)) return;
  var cf=L*W*(th/12);
  var withWaste=cf*(1+waste/100);
  var bags=Math.ceil(withWaste/yield_);
  var cy=withWaste/27;
  var bags80=Math.ceil(withWaste/0.60);
  document.getElementById('bags')!.textContent=bags.toLocaleString();
  document.getElementById('cy')!.textContent=cy.toFixed(2);
  document.getElementById('bags80')!.textContent=bags80.toLocaleString();
  document.getElementById('out')!.removeAttribute('hidden');
}
document.getElementById('go')!.addEventListener('click',calc);
</script>
