---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE_NAME, LAST_UPDATED } from '../lib/site';
---

<BaseLayout
  title={`Privacy Policy — ${SITE_NAME}`}
  description={`How ${SITE_NAME} collects, uses, and protects your data, and how Google AdSense and affiliate partners use cookies.`}
>
  <Breadcrumbs items={[{ name: 'Home', path: '/' }, { name: 'Privacy Policy' }]} />

  <section class="card">
    <h1>Privacy Policy</h1>
    <p class="lead">This page explains what data {SITE_NAME} collects, how it is used, and
      how advertising and affiliate partners use cookies.</p>
    <p>Last updated: {LAST_UPDATED}</p>
  </section>

  <section class="card">
    <h2>1. Information we collect</h2>
    <p>{SITE_NAME} is a set of client-side tools. The calculators run entirely in your browser —
      the numbers you type are <b>not sent to our servers</b> and are not stored. We do not require an
      account and do not collect personal information to use the tools.</p>
    <p>We may collect anonymous, aggregated usage data through privacy-friendly analytics to understand
      which tools are useful. This data cannot identify you.</p>
  </section>

  <section class="card">
    <h2>2. Advertising and cookies</h2>
    <p>This site may use Google AdSense to display ads. Google and its partners may use cookies to serve
      ads based on your prior visits to this or other websites. If you are in the European Economic Area
      or the United Kingdom, we will request consent before serving personalized ads.</p>
    <ul>
      <li>You can opt out of personalized advertising at
        <a href="https://www.google.com/settings/ads" rel="nofollow">Google Ads Settings</a>.</li>
      <li>You can review Google's practices in
        <a href="https://policies.google.com/technologies/ads" rel="nofollow">Google's advertising privacy policy</a>.</li>
      <li>You may disable cookies in your browser at any time; this will not break the calculators.</li>
    </ul>
  </section>

  <section class="card">
    <h2>3. Affiliate links</h2>
    <p>Some pages may contain affiliate links to retailers such as Home Depot or Lowe's. If you click a
      link and make a purchase, we may earn a small commission at no extra cost to you. See our
      <a href="/affiliate-disclosure/">affiliate disclosure</a>.</p>
  </section>

  <section class="card">
    <h2>4. Children's privacy</h2>
    <p>{SITE_NAME} is not directed at children under 13. We do not knowingly collect personal
      information from children.</p>
  </section>

  <section class="card">
    <h2>5. Your choices</h2>
    <p>You may request removal of any data we hold about you by contacting us via the
      <a href="/contact/">Contact page</a>. We will respond within a reasonable timeframe.</p>
  </section>

  <section class="card">
    <h2>6. Changes</h2>
    <p>We may update this policy. Material changes will be reflected by the “Last updated” date above.</p>
    <p class="muted">Contact: see our <a href="/contact/">Contact page</a>.</p>
  </section>
</BaseLayout>
