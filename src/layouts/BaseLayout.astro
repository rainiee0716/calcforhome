---
import { SITE_NAME } from '../lib/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  schema?: Record<string, any> | Record<string, any>[];
  noindex?: boolean;
  /** Page-specific 1200x630 card. Falls back to the site-wide image. */
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title,
  description,
  schema,
  noindex = false,
  ogImage: ogImageProp = '/og-image.png',
  ogImageAlt = `${SITE_NAME} — free home improvement calculators`,
} = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(ogImageProp, site).href;
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0b1220" />
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-9PD5DXMVFX"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-9PD5DXMVFX');
  </script>
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap.xml" />

  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogImageAlt} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <header class="site">
    <div class="wrap">
      <a class="logo" href="/" aria-label={`${SITE_NAME} home`}>
        <span class="logo-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 10.5 12 3l9 7.5" />
            <path d="M5.5 9.5V21h13V9.5" />
            <path d="M10 21v-6h4v6" />
          </svg>
        </span>
        CalcFor<span>Home</span>
      </a>
      <nav class="top" aria-label="Primary">
        <a href="/">Home</a>
        <a href="/concrete-calculator/">Concrete</a>
        <a href="/concrete-bags-calculator/">Bags</a>
        <a href="/gravel-driveway-calculator/">Gravel</a>
        <a href="/concrete-fence-post-calculator/">Fence Post</a>
        <a href="/lumber-calculator/">Lumber</a>
        <a href="/frost-depth-by-state/">Frost Depth</a>
      </nav>
    </div>
  </header>

  <main id="main-content" class="wrap">
    <slot />
  </main>

  <footer class="site">
    <div class="wrap">
      <div class="footer-grid">
        <div class="footer-brand">
          <a class="logo" href="/" aria-label={`${SITE_NAME} home`}>
            <span class="logo-mark" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 10.5 12 3l9 7.5" />
                <path d="M5.5 9.5V21h13V9.5" />
                <path d="M10 21v-6h4v6" />
              </svg>
            </span>
            CalcFor<span>Home</span>
          </a>
          <p>Free, single-purpose calculators for DIY concrete and gravel projects. Exact
            quantities, transparent math, no sign-up — your inputs never leave your device.</p>
        </div>
        <nav class="footer-col" aria-label="Calculators">
          <h4>Calculators</h4>
          <ul>
            <li><a href="/concrete-calculator/">Concrete Calculator</a></li>
            <li><a href="/concrete-bags-calculator/">Concrete Bags Calculator</a></li>
            <li><a href="/gravel-driveway-calculator/">Gravel for Driveway</a></li>
            <li><a href="/concrete-fence-post-calculator/">Concrete for Fence Post</a></li>
          </ul>
        </nav>
        <nav class="footer-col" aria-label="Company">
          <h4>Company</h4>
          <ul>
            <li><a href="/about/">About</a></li>
            <li><a href="/contact/">Contact</a></li>
            <li><a href="/privacy/">Privacy</a></li>
            <li><a href="/terms/">Terms</a></li>
            <li><a href="/affiliate-disclosure/">Affiliate disclosure</a></li>
          </ul>
        </nav>
      </div>
      <div class="footer-bottom">
        <span>© {year} {SITE_NAME}. All rights reserved.</span>
        <span>Built for homeowners &amp; DIYers.</span>
      </div>
    </div>
  </footer>
</body>
</html>
